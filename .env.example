# ---- Auth (Auth.js / NextAuth Google) ----
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allow-list of owner emails permitted to sign in.
ALLOWED_ADMIN_EMAILS=satviks.2010@gmail.com
# Secret used to encrypt the session JWT. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public base URL of this admin app (used for OAuth callbacks). e.g. https://cook-admin.vercel.app
# On Vercel this is inferred automatically; set it for local dev.
NEXTAUTH_URL=http://localhost:3000

# ---- Supabase (Postgres + Storage) ----
NEXT_PUBLIC_SUPABASE_URL=
# Service-role key — server-only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name for images + generated/uploaded audio (must be public).
SUPABASE_STORAGE_BUCKET=cook-media

# ---- TTS (Google Cloud Text-to-Speech) ----
# Optional. If unset, voice notes are left null and the cook app falls back to
# its own browser TTS. Create a key at https://console.cloud.google.com/apis/credentials
GOOGLE_TTS_API_KEY=
# Default language/voice for generated audio. Per-menu value overrides this.
TTS_LANG=en-IN

# ---- CORS ----
# Origin of the cook app, allowed to read GET /api/menus. Use * to allow any.
COOK_APP_ORIGIN=*
